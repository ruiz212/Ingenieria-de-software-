# Default deny: local secrets, test data and future unrelated files stay outside.
**
!app/
!app/**
!templates/
!templates/**
!static/
!static/**
!run.py
!config.py
!requirements.txt
!requirements.lock
!requirements-whatsapp.txt
!scripts/
